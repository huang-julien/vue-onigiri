{
  "name": "vue-onigiri-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "vue-onigiri monorepo root",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --filter playground dev",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "pnpm --filter vue-onigiri exec automd && oxlint --fix && oxfmt",
    "test": "pnpm --filter vue-onigiri test",
    "test:types": "pnpm -r test:types",
    "publish:all": "pnpm -r publish --access public",
    "release": "node --experimental-strip-types scripts/release.ts"
  },
  "devDependencies": {
    "changelogen": "^0.6.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.7.0"
}
