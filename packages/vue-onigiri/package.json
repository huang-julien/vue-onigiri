{
  "name": "vue-onigiri",
  "version": "0.8.0",
  "description": "HTML-first Vue islands: Vue SSR writes nonce-bound markers around v-load-client components, the client rebuilds VNodes from the DOM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huang-julien/vue-onigiri.git",
    "directory": "packages/vue-onigiri"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.mts",
      "import": "./dist/manifest.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "automd && oxlint --fix && oxfmt",
    "prepack": "pnpm build",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "vue-tsc",
    "bench": "pnpm bench:size && pnpm bench:client && pnpm bench:report",
    "bench:size": "vitest run --config vitest.bench.config.ts",
    "bench:ssr": "vitest bench --run --config vitest.bench.config.ts bench/ssr",
    "bench:client": "vitest bench --run --config vitest.browser-bench.config.ts --outputJson bench/results/client.json",
    "bench:report": "node --experimental-strip-types bench/report.ts",
    "bench:codspeed": "vitest bench --run --config vitest.bench.config.ts bench/ssr"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.33",
    "@vue/compiler-sfc": "^3.5.33",
    "@vue/shared": "^3.5.33",
    "knitwork": "^1.3.0",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/server-renderer": "^3.5.33",
    "@vue/test-utils": "^2.4.10",
    "automd": "^0.4.3",
    "happy-dom": "^20.9.0",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite": "catalog:",
    "vite-plugin-mcp": "^0.3.2",
    "vitest": "catalog:",
    "vue": "^3.5.33",
    "vue-onigiri-test-ui-lib": "workspace:*",
    "vue-tsc": "^3.2.8"
  },
  "peerDependencies": {
    "@vue/server-renderer": "^3.5.0",
    "vite": ">=6.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vue/server-renderer": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
