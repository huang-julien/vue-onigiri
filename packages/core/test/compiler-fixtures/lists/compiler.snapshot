import { renderList as _renderList } from "vue";
import { toDisplayString as _toDisplayString } from "vue";

export function renderOnigiri(_ctx, __instance) {
  return [
    0,
    "div",
    undefined,
    [
      [
        0,
        "ul",
        undefined,
        [
          ..._renderList(_ctx.items, (item, index) => [
            0,
            "li",
            { key: item.id },
            _toDisplayString(index) + " - " + _toDisplayString(item.label),
          ]),
        ],
      ],
      [
        0,
        "dl",
        undefined,
        [
          ..._renderList(_ctx.record, (value, key, index) => [
            0,
            "dt",
            { key: key },
            _toDisplayString(key) + ":" + _toDisplayString(value) + ":" + _toDisplayString(index),
          ]),
        ],
      ],
      ..._renderList(3, (n) => [0, "span", { key: n }, _toDisplayString(n)]),
      ..._renderList(_ctx.items, (item) => [
        3,
        [
          [0, "b", undefined, _toDisplayString(item.label)],
          ..._renderList(item.tags, (tag) => [0, "i", { key: tag }, _toDisplayString(tag)]),
        ],
      ]),
    ],
  ];
}
