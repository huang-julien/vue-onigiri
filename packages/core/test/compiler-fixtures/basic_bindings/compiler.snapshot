import { toDisplayString as _toDisplayString } from "vue";

export function renderOnigiri(_ctx, __instance) {
  return [
    0,
    "div",
    { class: "counter" },
    [
      [0, "span", undefined, [[2, _toDisplayString(_ctx.label)]]],
