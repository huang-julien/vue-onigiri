export function renderOnigiri(_ctx, __instance) {
  return [
    0,
    "div",
    undefined,
    [
      _ctx.status === "loading"
        ? [5, "<p>Loading</p>", 1]
        : _ctx.status === "error"
          ? [5, "<p>Error</p>", 1]
          : [5, "<p>Ready</p>", 1],
      _ctx.show ? [3, [[5, "<h2>Title</h2><p>Body</p>", 2]]] : null,
      _ctx.show ? [5, "<span>Only when shown</span>", 1] : null,
    ],
  ];
}
