export function renderOnigiri(_ctx, __instance) {
  return [
    0,
    "div",
    undefined,
    [
      _ctx.status === "loading"
        ? [0, "p", undefined, "Loading"]
        : _ctx.status === "error"
          ? [0, "p", undefined, "Error"]
          : [0, "p", undefined, "Ready"],
      _ctx.show
        ? [
            3,
            [
              [0, "h2", undefined, "Title"],
              [0, "p", undefined, "Body"],
            ],
          ]
        : null,
      _ctx.show ? [0, "span", undefined, "Only when shown"] : null,
    ],
  ];
}
